node_modules/

# Recordings are generated. `npm run demo` writes seed data on first run, and
# human .s1d files belong in pull requests, not in the history.
games/*/data/

*.log
.DS_Store

# The Kenney packs are vendor assets, several hundred megabytes of 3D models
# and vector source that a 2D canvas game never loads. Only the curated,
# renamed sprites under assets/sprites/ are tracked; drop the two kit folders in
# beside it and re-run `npm run serve` if you want the originals back.
assets/kenney_space-kit/
assets/kenney_space-shooter-extension/

# Keep the line endings the repo was authored with. Git's default on Windows
# would rewrite every file to CRLF on checkout, which churns diffs for no gain.
* text=auto eol=lf

# Binary assets and brains: never let line-ending translation touch them.
assets/sprites/** binary
games/**/*.s1b binary
games/**/*.s1d binary