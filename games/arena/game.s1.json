{
  "s1": 1,
  "id": "arena",
  "title": "Station Run",
  "blurb": "Capture the flag in a derelict station. Fixed map, no procedural generation. Steal the enemy flag, carry it to your base, do not shoot your own squad. Three lanes, a central pillar, and two base bumpers that force a flank.",
  "features": [
    "enemy_dist", "enemy_visible", "hp", "ammo", "cover_dist",
    "objective_dist", "allies_alive", "enemies_alive", "ability_ready", "time_left",
    "has_flag", "flag_stolen", "score_proximity", "carrier_dist"
  ],
  "actions": ["advance", "hold", "peek", "retreat", "rotate", "use_ability", "reload"],
  "contexts": ["execute", "default", "hold", "save"],
  "gate": {
    "inputs": ["pressure", "advantage"],
    "thresholds": [0.35, 0.15, -0.35, -0.1],
    "min_dwell_s": 0.6
  },
  "archetypes": ["entry", "support", "sniper"],
  "reward": { "kill": 1, "death": -1, "flag_take": 2, "capture": 5, "return": 1, "win": 8 },
  "budget_bytes": 1024,
  "sim": {
    "tick_rate": 20,
    "decision_every": 4,
    "match_seconds": 120,
    "team_size": 3,
    "captures_to_win": 3
  }
}